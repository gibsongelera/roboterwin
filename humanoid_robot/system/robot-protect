#!/usr/bin/env bash
# robot-protect: turn ON SD card protection, then reboot.
#
# After this the root filesystem is a RAM overlay on top of the read-only SD
# card, and the boot partition is mounted read-only. Nothing is ever written
# to the SD card, so switching the power off at ANY moment cannot corrupt it.
# All changes (logs, settings, files) live in RAM and disappear at reboot.
#
#   sudo robot-protect            ask, then enable and reboot
#   sudo robot-protect --yes      no question (used by the web Settings page)
#   sudo robot-protect --no-reboot
set -euo pipefail

YES=0
REBOOT=1
for arg in "$@"; do
  case "$arg" in
    -y|--yes) YES=1 ;;
    --no-reboot) REBOOT=0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

die() { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run with sudo"

if [ -d /boot/firmware ]; then BOOT=/boot/firmware; else BOOT=/boot; fi
CMDLINE="$BOOT/cmdline.txt"

if grep -q "boot=overlay" /proc/cmdline; then
  echo "SD card protection is already ON (PROTECTED mode)."
  exit 0
fi

# The overlay initramfs is built for the RUNNING kernel. If apt installed a
# newer kernel that has not been booted yet, the Pi would boot the new kernel
# with a mismatching initramfs. So require a reboot after kernel updates.
KERN="$(uname -r)"
[ -d "/lib/modules/$KERN" ] || die "modules for the running kernel ($KERN) are missing. Reboot first, then run robot-protect again."
FLAVOR="${KERN#*+}"
if [ -n "$FLAVOR" ] && [ "$FLAVOR" != "$KERN" ]; then
  NEWEST="$(ls -1 /lib/modules | grep -E "\+${FLAVOR}\$" | sort -V | tail -n 1)"
  [ "$NEWEST" = "$KERN" ] || die "kernel $NEWEST is installed but $KERN is running. Reboot first, then run robot-protect again."
fi

if [ "$YES" -ne 1 ]; then
  echo "This makes the SD card READ-ONLY and reboots the Pi."
  echo "Make sure the robot works and your calibration is saved first."
  read -r -p "Turn on SD card protection now? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || { echo "Cancelled."; exit 1; }
fi

echo "Making the boot partition read-only..."
raspi-config nonint enable_bootro || true
FSTAB_BOOT="$(awk '$2=="/boot/firmware" || $2=="/boot" {print $2; exit}' /etc/fstab)"
if [ -n "$FSTAB_BOOT" ] && ! awk -v m="$FSTAB_BOOT" '$2==m {print $4}' /etc/fstab | tr ',' '\n' | grep -qx ro; then
  # Fallback if raspi-config did not change the line
  sed -i -E "s#^([^[:space:]]+[[:space:]]+${FSTAB_BOOT}[[:space:]]+[^[:space:]]+[[:space:]]+)([^[:space:]]+)#\1\2,ro#" /etc/fstab
fi

echo "Enabling the read-only overlay file system (this builds an initramfs, ~1 minute)..."
raspi-config nonint enable_overlayfs
grep -q "boot=overlay" "$CMDLINE" || die "enabling the overlay failed: boot=overlay missing in $CMDLINE"
sync

echo "Done. After the reboot the robot is in PROTECTED mode."
if [ "$REBOOT" -eq 1 ]; then
  echo "Rebooting..."
  systemctl reboot
fi
